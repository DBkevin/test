{
  "plugin_id": "douyin",
  "plugin_name": "抖音团购插件",
  "version": 118,
  "enabled": true,
  "app_packages": ["com.ss.android.ugc.aweme"],
  "entry_package": "com.ss.android.ugc.aweme",
  "rule_assets": ["douyin_hospital_v1.json"],
  "capture_flow": {
    "app_start_delay_ms": 4000,
    "steps": [
      {
        "type": "search_keyword",
        "source": "hospital_name"
      },
      {
        "type": "wait",
        "duration_ms": 4000
      },
      {
        "type": "click_text_fuzzy",
        "source": "hospital_name",
        "max_scroll_rounds": 0
      },
      {
        "type": "wait_for_text",
        "target_texts": ["收藏", "回头客", "领券抢购", "已售"],
        "timeout_ms": 8000,
        "wait_ms": 600
      },
      {
        "type": "wait",
        "duration_ms": 1200
      }
    ],
    "collection": {
      "capture_timeout_ms": 60000,
      "capture_round_wait_ms": 2800,
      "expand_keywords": ["展开更多", "查看全部", "更多团购", "更多套餐", "全部团购", "全部套餐"],
      "expand_settle_ms": 1200,
      "max_expand_clicks_per_round": 4,
      "stop_texts_all": ["收起"],
      "stop_texts_any": [],
      "stop_texts_none": [],
      "scroll_settle_ms": 1800,
      "max_scroll_rounds": 14,
      "max_idle_scroll_rounds": 4
    }
  }
}
