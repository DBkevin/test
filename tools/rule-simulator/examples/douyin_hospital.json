{
  "rule_id": "douyin_hospital_v1",
  "app_id": "douyin",
  "app_package": "com.ss.android.ugc.aweme",
  "min_app_version": "20.0.0",
  "pages": [
    {
      "page_id": "hospital_detail",
      "match_rules": [
        {
          "type": "text_contains",
          "field": "page_text",
          "values": ["医院", "门诊", "整形", "美容"],
          "logic": "OR"
        }
      ],
      "extract_rules": {
        "hospital_name": {
          "type": "find_by_keywords",
          "keywords": ["医院", "门诊", "整形", "美容"],
          "location": "top",
          "max_depth": 3
        },
        "honors": {
          "type": "find_by_keywords",
          "keywords": ["认证", "奖", "基地", "定点", "授权"],
          "location": "near_hospital_name",
          "max_depth": 5
        },
        "group_buys": {
          "type": "find_list",
          "container": {
            "class": "androidx.recyclerview.widget.RecyclerView"
          },
          "item_rules": {
            "title": {
              "type": "find_by_keywords",
              "keywords": ["团购", "套餐", "体验", "次卡", "疗程"]
            },
            "price": {
              "type": "regex",
              "pattern": "¥(\\d+(?:\\.\\d+)?)"
            },
            "sales": {
              "type": "find_by_keywords",
              "keywords": ["已售", "销量", "购买"]
            }
          }
        }
      }
    }
  ]
}
