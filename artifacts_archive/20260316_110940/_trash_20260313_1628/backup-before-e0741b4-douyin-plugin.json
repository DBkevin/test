{
  "plugin_id": "douyin",
  "plugin_name": "抖音团购插件",
  "version": 105,
  "enabled": true,
  "app_packages": ["com.ss.android.ugc.aweme"],
  "entry_package": "com.ss.android.ugc.aweme",
  "rule_assets": ["douyin_hospital_v1.json"],
  "capture_flow": {
    "app_start_delay_ms": 2500,
    "steps": [
      {
        "type": "click_text",
        "target_text": "团购",
        "wait_ms": 1200
      },
      {
        "type": "search_keyword",
        "source": "hospital_name"
      },
      {
        "type": "wait",
        "duration_ms": 2500
      },
      {
        "type": "click_text_fuzzy",
        "source": "hospital_name",
        "max_scroll_rounds": 3
      },
      {
        "type": "wait",
        "duration_ms": 2200
      }
    ],
    "collection": {
      "capture_timeout_ms": 60000,
      "capture_round_wait_ms": 2500,
      "scroll_settle_ms": 1800,
      "max_scroll_rounds": 6,
      "max_idle_scroll_rounds": 2
    }
  }
}
