# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.iws

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
.svn/

# OS-specific files
.DS_Store
Thumbs.db

# Local/Private files
*.key
*.pem
*secret*

# Local debug artifacts kept outside normal source control flow.
# Curated baseline assets under artifacts/ root may still be tracked manually.
artifacts_archive/
artifacts/backup-before-*/
artifacts/backup-runtime-plugin-*/
artifacts/run_*/
artifacts/flow_boundary_seek/
artifacts/flow_boundary_seek_next/
artifacts/flow_expand_chain/
